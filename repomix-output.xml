      <div className="pt-2">
        {activeTab === "manage" && (
          <AdminStaffTable 
            staffList={staffList} 
            onEdit={triggerEditMode} 
            onDelete={handleDeleteStaff} 
          />
        )}

        {activeTab === "register" && (
          <AdminAddStaffForm 
            schoolId={schoolId} 
            onSuccess={() => setActiveTab("manage")} 
          />
        )}

        {activeTab === "edit" && editingStaff && (
          <AdminEditStaffForm 
            staff={editingStaff} 
            onSuccess={() => setActiveTab("manage")} 
            onCancel={() => setActiveTab("manage")} 
          />
        )}
      </div>
    </div>
  );
};

export default AdminDashboard;
